[Unit]
Description=Aria AI Influencer 24/7 Instagram Agent & Webhook Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aria-agent
Group=aria-agent
WorkingDirectory=/opt/aria-ai-influencer
EnvironmentFile=/opt/aria-ai-influencer/.env
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Tehran
ExecStart=/opt/aria-ai-influencer/.venv/bin/python /opt/aria-ai-influencer/instagram_ai_agent.py --run-daemon
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aria-ai-influencer/data

[Install]
WantedBy=multi-user.target
