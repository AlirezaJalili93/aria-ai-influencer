# ============================================================================
# تنظیمات محیطی ایجنت «آریا» — اولین اینفلوئنسر هوش مصنوعی ایران
# این فایل را به .env کپی کنید و مقادیر واقعی را قرار دهید:
# cp .env.example .env
# ============================================================================

# --- ۱. تنظیمات اتصال مستقیم به اکانت اینستاگرام (Meta Graph API v21.0) ---
IG_ACCESS_TOKEN="EAA_YOUR_META_GRAPH_API_ACCESS_TOKEN"
IG_USER_ID="17841400000000000"
IG_WEBHOOK_VERIFY_TOKEN="iran_first_ai_influencer_secret"
IG_GRAPH_API_VERSION="v21.0"

# --- ۲. کلیدهای هوش مصنوعی (Multi-AI Router & Failover) ---
GEMINI_API_KEY="AIzaSy_YOUR_GEMINI_KEY"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""

# درگاه‌های هوش مصنوعی ایرانی یا سازگار با OpenAI (مثلاً AvalAI / GapGPT)
CUSTOM_AI_BASE_URL="https://api.avalai.ir/v1"
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL="gpt-4o-mini"

# --- ۳. تنظیمات سرور وب‌هوک و زمان‌بندی ۲۴/۷ ---
WEBHOOK_HOST="0.0.0.0"
WEBHOOK_PORT="8080"
TIMEZONE="Asia/Tehran"
DAILY_TOKEN_BUDGET="500000"
