# Copy to .env on the server. Never commit real credentials.
# IG account must be a Meta-connected Business/Creator account.
IG_ACCESS_TOKEN=""
IG_USER_ID=""
IG_WEBHOOK_VERIFY_TOKEN=""
META_APP_SECRET=""
IG_GRAPH_VERSION="v21.0"

AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
CUSTOM_AI_BASE_URL="https://api.avalai.ir/v1"
CUSTOM_AI_API_KEY=""
CUSTOM_AI_SCENARIO_MODEL="gpt-4o"
CUSTOM_AI_FAST_MODEL="gpt-4o-mini"
DEFAULT_DAILY_TOKEN_LIMIT="500000"
# Legacy helper only; dashboard speech uses the OpenAI vault key above.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB"
FAL_API_KEY=""

# Admin API has no login: bind locally and use an SSH tunnel.
# Optional password-protected public HTTPS frontend: docs/public_dashboard.md.
# Expose only /webhook through an HTTPS reverse proxy after setting META_APP_SECRET.
AGENT_WEBHOOK_HOST="127.0.0.1"
AGENT_WEBHOOK_PORT="8080"
AGENT_DB_PATH="/opt/aria-ai-influencer/data/instagram_agent_state.db"
AGENT_POLL_INTERVAL="120"
TZ="Asia/Tehran"

# Optional studio image-generation model (OpenAI key is managed in the vault)
OPENAI_IMAGE_MODEL=gpt-image-1

# Persian character speech; a dashboard OpenAI key is also sufficient.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
